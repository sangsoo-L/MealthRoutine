# 밀스루틴 운영 Caddy 설정 (서버 위치: /opt/mealthroutine/Caddyfile)
# - 화면과 /api를 같은 도메인에서 제공한다(프론트의 같은 출처 설계, refresh 쿠키 Secure·Path=/api/v1/auth).
# - 인증서는 Caddy가 Let's Encrypt에서 자동 발급·갱신한다. http는 자동으로 https로 넘긴다.
{
	acme_ca {$ACME_CA}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# API는 Spring으로 전달한다. 경로는 바꾸지 않는다(/api/v1/... 그대로).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# 그 밖의 경로는 React 빌드 결과(dist)를 보낸다.
	# 없는 경로(/login, /mypage 등 화면 주소)는 index.html로 보내 새로고침해도 화면이 열리게 한다.
	handle {
		root * /srv/releases/current/dist
		# 파일 이름에 해시가 붙은 정적 파일은 오래 캐시하고, 나머지(index.html 등)는 매번 확인하게 한다.
		# 그래야 새 버전을 배포했을 때 사용자가 옛 화면에 머물지 않는다.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@other not path /assets/*
		header @other Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
