# 서버의 /opt/mealthroutine/.env 예시. 키 이름만 적는다. 실제 값은 서버에서 직접 만들고(권한 600)
# Git·채팅·커밋 메시지·작업현황에 옮기지 않는다(DEPLOY-9, JWT-KEY-4).

# 접속 주소(https:// 없이). 예: 구입한 도메인. 도메인이 늦으면 공인 IP를 대시로 쓴 <a-b-c-d>.sslip.io
SITE_ADDRESS=

# 첫 시험은 staging(가짜 인증서, 발급 한도 걱정 없음). 확인되면 이 줄을 지우고 caddy를 재시작해 실제 인증서로 바꾼다.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# 운영 DB 비밀번호. 개발 값 재사용 금지. 서버에서: openssl rand -hex 24
DB_PASSWORD=

# 운영 JWT 키(Base64, 32바이트 이상). 개발·테스트 키와 다르게. 서버에서: openssl rand -base64 32
JWT_SECRET=
